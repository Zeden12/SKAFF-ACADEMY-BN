# Application
NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skaff_academy?schema=public

# Frontend origin allowed to call this API (used for CORS)
FRONTEND_URL=http://localhost:3001

# JWT access tokens
# Generate a real secret for each environment, e.g.: openssl rand -base64 48
# Never reuse this placeholder and never commit a real secret.
JWT_SECRET=replace-with-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=1d
