generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  STUDENT
  STAFF
}

enum StudentStatus {
  ACTIVE
  PENDING_PAYMENT
  ON_HOLD
  SUSPENDED
  COMPLETED
  WITHDRAWN
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum IntakeStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ClassStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  SUSPENDED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  ENROLLED
}

enum EducationLevel {
  PRIMARY
  SECONDARY
  VOCATIONAL
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
}

enum ApplicationDocumentType {
  IDENTIFICATION
  PHOTO
  ACADEMIC
  ADDITIONAL
}

enum ApplicationHistoryActorType {
  APPLICANT
  STAFF
  SYSTEM
}

enum ApplicationHistoryVisibility {
  PUBLIC
  INTERNAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  userType     UserType
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
}

model StudentProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  studentNumber String        @unique
  fullName      String
  phone         String?
  dateOfBirth   DateTime?
  nationality   String?
  address       String?
  status        StudentStatus @default(ACTIVE)
  statusMessage String?
  internalNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
}

model StaffProfile {
  id        String      @id @default(cuid())
  userId    String      @unique
  fullName  String
  phone     String?
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes ClassGroup[]
}

model Program {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  code         String   @unique
  description  String?
  displayOrder Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  intakes      Intake[]
  classGroups  ClassGroup[]
  enrollments  Enrollment[]
  applications Application[]

  @@index([displayOrder])
}

model Intake {
  id                 String       @id @default(cuid())
  name               String
  programId          String
  status             IntakeStatus @default(UPCOMING)
  applicationsOpen   Boolean      @default(false)
  applicationOpenAt  DateTime?
  applicationCloseAt DateTime?
  capacity           Int?
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  program      Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  classGroups  ClassGroup[]
  enrollments  Enrollment[]
  applications Application[]

  @@index([programId])
  @@index([status])
  @@index([applicationsOpen])
}

model ClassGroup {
  id        String      @id @default(cuid())
  name      String
  code      String      @unique
  programId String
  intakeId  String
  trainerId String?
  status    ClassStatus @default(UPCOMING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  program     Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  intake      Intake        @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  trainer     StaffProfile? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]

  @@index([programId])
  @@index([intakeId])
  @@index([trainerId])
}

model Enrollment {
  id            String           @id @default(cuid())
  studentId     String
  programId     String
  intakeId      String
  classGroupId  String?
  applicationId String?          @unique
  status        EnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime         @default(now())
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program     Program        @relation(fields: [programId], references: [id], onDelete: Restrict)
  intake      Intake         @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  classGroup  ClassGroup?    @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  application Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([studentId, intakeId])
  @@index([studentId])
  @@index([programId])
  @@index([intakeId])
  @@index([classGroupId])
}

// =====================================================
// ADMISSIONS DOMAIN (Backend Phase 2)
//
// Program → Intake → Application → (approved) → explicit
// enrollment conversion → User + StudentProfile + Enrollment.
// Approval never auto-creates a student — see EnrollmentConversionService.
// =====================================================

model Application {
  id        String            @id @default(cuid())
  reference String            @unique
  programId String
  intakeId  String
  status    ApplicationStatus @default(DRAFT)

  // Personal information
  fullName       String
  email          String
  phone          String
  dateOfBirth    DateTime?
  nationality    String?
  currentAddress String?

  // Education
  highestEducationLevel EducationLevel?
  previousInstitution   String?
  fieldOfStudy          String?
  completionYear        Int?
  educationNotes        String?

  // Operational
  applicantFacingMessage String?
  internalAdminNotes     String?
  submittedAt            DateTime?
  reviewedAt             DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  enrolledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  program    Program                   @relation(fields: [programId], references: [id], onDelete: Restrict)
  intake     Intake                    @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  documents  ApplicationDocument[]
  history    ApplicationHistoryEntry[]
  enrollment Enrollment?

  @@index([email])
  @@index([programId])
  @@index([intakeId])
  @@index([status])
  @@index([submittedAt])
}

model ApplicationDocument {
  id            String                  @id @default(cuid())
  applicationId String
  type          ApplicationDocumentType
  fileName      String
  mimeType      String
  fileSize      Int
  storageKey    String?
  fileUrl       String?
  createdAt     DateTime                @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ApplicationHistoryEntry {
  id            String                       @id @default(cuid())
  applicationId String
  action        String
  actorType     ApplicationHistoryActorType
  actorName     String?
  message       String?
  visibility    ApplicationHistoryVisibility @default(INTERNAL)
  createdAt     DateTime                     @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdAt])
}

// Generic atomic counter backing server-generated identifiers (application
// references, student numbers, ...). One row per counter "key" (e.g.
// `application-2026`); incremented via an atomic upsert, never read-then-write
// from application code. See SequenceService.
model SequenceCounter {
  key   String @id
  value Int    @default(0)
}
